class Solution {
public:
    int titleToNumber(string columnTitle) {
        int result = 0;
        int power = 1;

        for(int i = columnTitle.size() - 1; i >= 0; i--) {
            result += (columnTitle[i] - 'A' + 1) * power;
            power *= 26;
        }

        return result;
    }
};
